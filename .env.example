# Copy these variables into Vercel: Project Settings > Environment Variables
# Enable for Production and Preview environments.

# Supabase pooled connection (pgbouncer, port 6543)
DATABASE_URL="postgresql://USER:PASSWORD@HOST.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase direct connection (port 5432) — used by Prisma migrations only
DIRECT_URL="postgresql://USER:PASSWORD@HOST.pooler.supabase.com:5432/postgres"

# Site origin only — do NOT include /api/auth (NextAuth appends that path)
NEXTAUTH_URL="https://www.surf.shanedrice.com"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

NEXT_PUBLIC_URL="https://www.surf.shanedrice.com"

GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Google Cloud Console > Credentials > OAuth 2.0 Client:
# Authorized JavaScript origins:
#   - https://www.surf.shanedrice.com
#   - https://<your-preview>.vercel.app
# Authorized redirect URIs:
#   - https://www.surf.shanedrice.com/api/auth/callback/google
#   - https://<your-preview>.vercel.app/api/auth/callback/google
